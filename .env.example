# Optional shell environment. The Python service uses the normal AWS SDK profile.
# Do not put AWS secret keys in this repo or in the browser.
AWS_PROFILE=lookout
AWS_REGION=us-east-1
LOOKOUT_BEDROCK_MODEL_ID=YOUR_ENABLED_MODEL_OR_INFERENCE_PROFILE_ID
# This file is a reference; the service does not auto-load dotenv files.
# Recommended: python -m companion.configure (non-secret local-config.json).
